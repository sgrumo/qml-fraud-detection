# Copy to .env and fill in. .env is git-ignored and loaded by the qfd CLI.

# Kaggle API token for `qfd download` (https://www.kaggle.com/settings/api)
KAGGLE_API_TOKEN=

# AWS Braket (or use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
AWS_PROFILE=
AWS_REGION=us-east-1

# Google Quantum Engine (also run: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=

# D-Wave Leap
DWAVE_API_TOKEN=
